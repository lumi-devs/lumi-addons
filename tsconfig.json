{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["bun"],
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@lumi-devs/lumi/module": ["./.lumi/src/lib/module-system/Module.ts"],
      "@lumi-devs/lumi/commands": ["./.lumi/src/lib/commands/CommandDef.ts"],
      "@lumi-devs/lumi/context": ["./.lumi/src/lib/commands/Context.ts"],
      "@lumi-devs/lumi/listeners": ["./.lumi/src/lib/listeners/ListenerDef.ts"],
      "@lumi-devs/lumi/interactions": ["./.lumi/src/lib/interactions/InteractionDef.ts"],
      "@lumi-devs/lumi/ui": ["./.lumi/src/lib/ui/Cards.ts"],
      "@lumi-devs/lumi/config": ["./.lumi/src/lib/module-system/ConfigSchema.ts"],
      "@lumi-devs/lumi/api": ["./.lumi/src/lib/ModuleApi.ts"],
      "@lumi-devs/lumi/lib/*": ["./.lumi/src/lib/*"],
      "@lumi-devs/lumi": ["./.lumi/src/Index.ts"]
    }
  },
  "include": ["*/Index.ts", "*/commands/**/*.ts", "*/listeners/**/*.ts", "*/interactions/**/*.ts", "*/tasks/**/*.ts", "*/services/**/*.ts", "*/data/**/*.ts", "*/utilities/**/*.ts", "*/lib/**/*.ts"],
  "exclude": ["node_modules", "scripts", "docs", "dist", "coverage", "data"]
}
