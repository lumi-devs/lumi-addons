{
  "name": "lumi-addons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "First-party dynamic addons for the Lumi Discord bot. Not a package — each directory is installed individually by Lumi's downloader.",
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "bunx @changesets/cli",
    "version:sync": "bunx @changesets/cli version && bun scripts/version-sync.ts",
    "check:loader": "bun scripts/mock-lumi-check.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.10"
  }
}
